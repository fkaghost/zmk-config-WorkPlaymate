/*
 * WorkPlayMate - Left-Side Corne Keymap
 * nice!nano v2 + nice!view
 *
 * Bluetooth:
 * - Two host profiles (configured in corne.conf)
 * - BT_NXT cycles between profiles 1 and 2
 * - First key on row 2: hold for 4 seconds to BT_CLR current profile
 *
 * Layer switching:
 * - Top-left on PLAY -> WORK
 * - Top-left on WORK -> PLAY
 * - Top-left on WORK2 -> PLAY
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define PLAY  0
#define WORK  1
#define WORK2 2

/ {
    /*
     * &bt takes more parameters than a hold-tap can forward directly,
     * so wrap BT_CLR in a zero-parameter macro.
     */
    macros {
        bt_clear_macro: bt_clear_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };
    };

    /*
     * Tap: does nothing.
     * Hold 4 seconds: invokes bt_clear_macro, which clears the
     * currently selected Bluetooth profile.
     *
     * tap-preferred prevents another key press during the four-second
     * window from prematurely resolving this as a hold.
     */
    behaviors {
        bt_clear_hold: bt_clear_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <4000>;
            bindings = <&bt_clear_macro>, <&none>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * ============================================================
         * LAYER 0 — PLAY
         * ============================================================
         *
         * | WORK | BT 1 | BT 2 |   1   |   2   | BT NXT |
         * | CLR* | TAB  |  Q   |   W   |   E   |   R    |
         * | MUTE | SHFT |  A   |   S   |   D   |   F    |
         *                  | 3 | 4 | SPACE |
         *
         * CLR* = hold 4 seconds to clear current BT profile
         * RIGHT HALF = NONE
         */
        play_layer {
            display-name = "Play";

            bindings = <
                /* Row 1 */
                &to WORK       &bt BT_SEL 0   &bt BT_SEL 1
                &kp N1         &kp N2         &bt BT_NXT

                &none          &none          &none
                &none          &none          &none

                /* Row 2 */
                &bt_clear_hold 0 0
                &kp TAB        &kp Q
                &kp W          &kp E           &kp R

                &none          &none          &none
                &none          &none          &none

                /* Row 3 */
                &kp C_MUTE     &kp LSHIFT      &kp A
                &kp S          &kp D           &kp F

                &none          &none          &none
                &none          &none          &none

                /* Thumbs */
                &kp N3         &kp N4          &kp SPACE

                &none          &none          &none
            >;
        };

        /*
         * ============================================================
         * LAYER 1 — WORK
         * ============================================================
         *
         * | PLAY | BT 1 | BT 2 | NONE | NONE | BT NXT |
         * | CLR* | NONE | DEL  | HOME | END  | WIN+.  |
         * | MUTE | BKSP | COPY | PASTE| SP.P | PRTSC  |
         *                  | 3 | SPACE | LAYER 2 |
         *
         * CLR* = hold 4 seconds to clear current BT profile
         * Special Paste = CTRL + SHIFT + V
         * RIGHT HALF = NONE
         */
        work_layer {
            display-name = "Work";

            bindings = <
                /* Row 1 */
                &to PLAY       &bt BT_SEL 0   &bt BT_SEL 1
                &none          &none          &bt BT_NXT

                &none          &none          &none
                &none          &none          &none

                /* Row 2 */
                &bt_clear_hold 0 0
                &none          &kp DELETE
                &kp HOME       &kp END         &kp LG(DOT)

                &none          &none          &none
                &none          &none          &none

                /* Row 3 */
                &kp C_MUTE     &kp BACKSPACE   &kp LC(C)
                &kp LC(V)      &kp LC(LS(V))   &kp PRINTSCREEN

                &none          &none          &none
                &none          &none          &none

                /* Thumbs */
                &kp N3         &kp SPACE       &mo WORK2

                &none          &none           &none
            >;
        };

        /*
         * ============================================================
         * LAYER 2 — WORK 2
         * ============================================================
         *
         * | PLAY | BT 1  | BT 2 | NONE | NONE | BT NXT |
         * | CLR* | NONE  | NONE | SEL ALL | NONE | WIN+. |
         * | MUTE | S+TAB | TAB  | BOLD | ITALIC | PRTSC |
         *                   | NONE | NONE | THROUGH |
         *
         * CLR* = hold 4 seconds to clear current BT profile
         * THROUGH = transparent to Layer 1
         * RIGHT HALF = NONE
         */
        work2_layer {
            display-name = "Work2";

            bindings = <
                /* Row 1 */
                &to PLAY       &bt BT_SEL 0   &bt BT_SEL 1
                &none          &none          &bt BT_NXT

                &none          &none          &none
                &none          &none          &none

                /* Row 2 */
                &bt_clear_hold 0 0
                &none          &none
                &kp LC(A)      &none           &kp LG(DOT)

                &none          &none          &none
                &none          &none          &none

                /* Row 3 */
                &kp C_MUTE     &kp LS(TAB)     &kp TAB
                &kp LC(B)      &kp LC(I)       &kp PRINTSCREEN

                &none          &none           &none
                &none          &none           &none

                /* Thumbs */
                &none          &none           &trans

                &none          &none           &none
            >;
        };
    };
};
