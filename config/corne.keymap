/*
 * WorkPlayMate - Left-Side Corne Keymap
 * nice!nano v2 + nice!view
 *
 * Bluetooth:
 * - Two host profiles (configured in corne.conf)
 * - BT_NXT cycles between profiles 1 and 2
 * - First key on row 2: hold for 4 seconds to BT_CLR current profile
 *
 * Layer switching:
 * - Top-left on PLAY  -> WORK
 * - Top-left on WORK  -> PLAY
 * - Top-left on WORK2 -> PLAY
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define PLAY  0
#define WORK  1
#define WORK2 2

/ {
    macros {
        bt_clear_macro: bt_clear_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };
    };

    behaviors {
        bt_clear_hold: bt_clear_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <4000>;
            bindings = <&bt_clear_macro>, <&none>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * ============================================================
         * LAYER 0 — PLAY
         * ============================================================
         *
         * | WORK |  1   |  2   |   3   |   4   | BT NXT |
         * | CLR* | TAB  |  Q   |   W   |   E   |   R    |
         * | MUTE | SHFT |  A   |   S   |   D   |   F    |
         *                  | 5 | 6 | SPACE |
         *
         * CLR* = hold 4 seconds to clear current BT profile
         * RIGHT HALF = NONE
         */
        play_layer {
            display-name = "Play";

            bindings = <
                /* Row 1:  WORK     1         2         3         4         BT NXT       | right half */
                &to WORK            &kp N1    &kp N2    &kp N3    &kp N4    &bt BT_NXT     &none &none &none &none &none &none

                /* Row 2:  CLR*     TAB       Q         W         E         R            | right half */
                &bt_clear_hold 0 0   &kp TAB   &kp Q     &kp W     &kp E     &kp R         &none &none &none &none &none &none

                /* Row 3:  MUTE     SHFT      A         S         D         F            | right half */
                &kp C_MUTE          &kp LSHIFT &kp A    &kp S     &kp D     &kp F         &none &none &none &none &none &none

                /* Thumbs: 5        6         SPACE                                      | right half */
                &kp N5              &kp N6     &kp SPACE                                   &none &none &none
            >;
        };

        /*
         * ============================================================
         * LAYER 1 — WORK
         * ============================================================
         *
         * | PLAY |  1   |  2   |   3   |   4   | BT NXT |
         * | CLR* | NONE | DEL  | HOME  | END   | WIN+.  |
         * | MUTE | BKSP | COPY | PASTE | SP.P  | PRTSC  |
         *                | ENTER | SPACE | LAYER 2 |
         *
         * CLR* = hold 4 seconds to clear current BT profile
         * Special Paste = CTRL + SHIFT + V
         * RIGHT HALF = NONE
         */
        work_layer {
            display-name = "Work";

            bindings = <
                /* Row 1:  PLAY     1         2         3         4         BT NXT       | right half */
                &to PLAY            &kp N1    &kp N2    &kp N3    &kp N4    &bt BT_NXT     &none &none &none &none &none &none

                /* Row 2:  CLR*     NONE      DEL       HOME      END       WIN+.        | right half */
                &bt_clear_hold 0 0   &none     &kp DELETE &kp HOME &kp END   &kp LG(DOT)    &none &none &none &none &none &none

                /* Row 3:  MUTE     BKSP      COPY      PASTE     SP.P      PRTSC        | right half */
                &kp C_MUTE          &kp BACKSPACE &kp LC(C) &kp LC(V) &kp LC(LS(V)) &kp PRINTSCREEN  &none &none &none &none &none &none

                /* Thumbs: ENTER    SPACE     LAYER 2                                    | right half */
                &kp ENTER           &kp SPACE  &mo WORK2                                   &none &none &none
            >;
        };

        /*
         * ============================================================
         * LAYER 2 — WORK 2
         * ============================================================
         *
         * | PLAY | NONE  | NONE | NONE    | NONE | BT NXT |
         * | CLR* | NONE  | UNDO | SEL ALL | REDO | WIN+.  |
         * | MUTE | S+TAB | TAB  | BOLD    | ITAL | PRTSC  |
         *                  | NONE | NONE | THROUGH |
         *
         * CLR* = hold 4 seconds to clear current BT profile
         * UNDO = CTRL + Z
         * REDO = CTRL + Y
         * THROUGH = transparent to Layer 1
         * RIGHT HALF = NONE
         */
        work2_layer {
            display-name = "Work2";

            bindings = <
                /* Row 1:  PLAY     NONE      NONE      NONE      NONE      BT NXT       | right half */
                &to PLAY            &none      &none      &none      &none      &bt BT_NXT   &none &none &none &none &none &none

                /* Row 2:  CLR*     NONE      UNDO      SEL ALL   REDO      WIN+.        | right half */
                &bt_clear_hold 0 0   &none      &kp LC(Z)  &kp LC(A)  &kp LC(Y)  &kp LG(DOT)  &none &none &none &none &none &none

                /* Row 3:  MUTE     S+TAB     TAB       BOLD      ITAL      PRTSC        | right half */
                &kp C_MUTE          &kp LS(TAB) &kp TAB   &kp LC(B)  &kp LC(I)  &kp PRINTSCREEN  &none &none &none &none &none &none

                /* Thumbs: NONE     NONE      THROUGH                                    | right half */
                &none               &none      &trans                                      &none &none &none
            >;
        };
    };
};
