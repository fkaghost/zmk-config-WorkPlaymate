/*
 * Custom Left-Side Corne Keymap
 * nice!nano v2 + nice!view
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>


#define PLAY  0
#define WORK  1
#define WORK2 2


/ {
    keymap {
        compatible = "zmk,keymap";


        /*
         * ============================================================
         * LAYER 0 — PLAY
         * ============================================================
         *
         * LEFT HALF
         *
         * | PLAY | BT 1 | BT 2 |   1   |   2   | BT CLR |
         * | WORK | TAB  |  Q   |   W   |   E   |   R    |
         * | MUTE | SHFT |  A   |   S   |   D   |   F    |
         *                  | 3 | 4 | SPACE |
         *
         * RIGHT HALF = NONE
         */

        play_layer {
            display-name = "Play";

            bindings = <
                /* Row 1 */
                &to PLAY       &bt BT_SEL 0   &bt BT_SEL 1
                &kp N1         &kp N2         &bt BT_CLR

                &none          &none          &none
                &none          &none          &none


                /* Row 2 */
                &to WORK       &kp TAB         &kp Q
                &kp W          &kp E           &kp R

                &none          &none           &none
                &none          &none           &none


                /* Row 3 */
                &kp C_MUTE     &kp LSHIFT      &kp A
                &kp S          &kp D           &kp F

                &none          &none           &none
                &none          &none           &none


                /* Thumbs */
                &kp N3         &kp N4          &kp SPACE

                &none          &none           &none
            >;
        };


        /*
         * ============================================================
         * LAYER 1 — WORK
         * ============================================================
         *
         * LEFT HALF
         *
         * | PLAY | BT 1 | BT 2 | NONE | NONE | BT CLR |
         * | WORK | NONE | DEL  | HOME | END  | WIN+.  |
         * | MUTE | BKSP | COPY | PASTE| SP.P | PRTSC  |
         *                  | 3 | SPACE | LAYER 2 |
         *
         * Special Paste = CTRL + SHIFT + V
         * RIGHT HALF = NONE
         */

        work_layer {
            display-name = "Work";

            bindings = <
                /* Row 1 */
                &to PLAY       &bt BT_SEL 0   &bt BT_SEL 1
                &none          &none          &bt BT_CLR

                &none          &none          &none
                &none          &none          &none


                /* Row 2 */
                &to WORK       &none           &kp DELETE
                &kp HOME       &kp END         &kp LG(DOT)

                &none          &none           &none
                &none          &none           &none


                /* Row 3 */
                &kp C_MUTE     &kp BACKSPACE   &kp LC(C)
                &kp LC(V)      &kp LC(LS(V))   &kp PRINTSCREEN

                &none          &none           &none
                &none          &none           &none


                /* Thumbs */
                &kp N3         &kp SPACE       &mo WORK2

                &none          &none           &none
            >;
        };


        /*
         * ============================================================
         * LAYER 2 — WORK 2
         * ============================================================
         *
         * LEFT HALF
         *
         * | PLAY | BT 1  | BT 2 | NONE | NONE | BT CLR |
         * | WORK | NONE  | NONE | SEL ALL | NONE | WIN+. |
         * | MUTE | S+TAB | TAB  | BOLD | ITALIC | PRTSC |
         *                   | NONE | NONE | THROUGH |
         *
         * THROUGH = transparent to Layer 1
         * RIGHT HALF = NONE
         */

        work2_layer {
            display-name = "Work2";

            bindings = <
                /* Row 1 */
                &to PLAY       &bt BT_SEL 0   &bt BT_SEL 1
                &none          &none          &bt BT_CLR

                &none          &none          &none
                &none          &none          &none


                /* Row 2 */
                &to WORK       &none           &none
                &kp LC(A)      &none           &kp LG(DOT)

                &none          &none           &none
                &none          &none           &none


                /* Row 3 */
                &kp C_MUTE     &kp LS(TAB)     &kp TAB
                &kp LC(B)      &kp LC(I)       &kp PRINTSCREEN

                &none          &none           &none
                &none          &none           &none


                /* Thumbs */
                &none          &none           &trans

                &none          &none           &none
            >;
        };
    };
};
